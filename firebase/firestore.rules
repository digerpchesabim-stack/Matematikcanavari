rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function lbOk(c) { return c in ['lbg_add','lbg_add_o','lbg_add_z','lbg_sub','lbg_sub_o','lbg_sub_z','lbg_mul','lbg_mul_o','lbg_mul_z','lbg_div','lbg_div_o','lbg_div_z','lbg_rnd','lbg_rnd_o','lbg_rnd_z','lbr_add','lbr_add_o','lbr_add_z','lbr_sub','lbr_sub_o','lbr_sub_z','lbr_mul','lbr_mul_o','lbr_mul_z','lbr_div','lbr_div_o','lbr_div_z','lbr_rnd','lbr_rnd_o','lbr_rnd_z']; }

    // Yarış odaları
    match /rooms/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.host == request.auth.uid
        && request.resource.data.keys().hasOnly(['host', 'hostNick', 'op', 'status', 'seed', 'created', 'qv', 'lv', 'tb', 'mode', 'win', 'at', 'ka', 'kb', 'cm'])
        && (!('at' in request.resource.data) || request.resource.data.at is int)
        && (!('mode' in request.resource.data) || request.resource.data.mode in ['duel', 'mm', 'tw'])
        && (!('win' in request.resource.data) || request.resource.data.win in [10, 15, 20])
        && (!('lv' in request.resource.data) || request.resource.data.lv in ['k', 'o', 'z'])
        && (!('tb' in request.resource.data) || (request.resource.data.tb is int && request.resource.data.tb >= 0 && request.resource.data.tb <= 10))
        && request.resource.data.status == 'lobby'
        && request.resource.data.op in ['add', 'sub', 'mul', 'div', 'rnd']
        && code.size() >= 3 && code.size() <= 10;
      // Sadece kurucu, sadece durumu "playing" yapabilir
      allow update: if signedIn()
        && resource.data.host == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'pa'])
        && (!('pa' in request.resource.data) || (request.resource.data.pa is string && request.resource.data.pa.size() <= 600))
        && request.resource.data.status == 'playing';
      allow delete: if signedIn() && (resource.data.host == request.auth.uid
        || request.time.toMillis() - resource.data.created > 86400000);

      match /players/{uid} {
        allow read: if signedIn();
        // Yeni oyuncu sadece oda "lobby" iken girebilir
        allow create: if signedIn() && request.auth.uid == uid
          && get(/databases/$(database)/documents/rooms/$(code)).data.status == 'lobby'
          && request.resource.data.keys().hasOnly(['nick', 'score', 'hearts', 'ok', 'bad', 'n', 'tt', 'done', 'ts', 'rid', 'm', 'r', 'pr', 'pid', 'jt', 'rk', 'pv', 'tk', 'br'])
          && request.resource.data.nick is string && request.resource.data.nick.size() <= 60;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['nick', 'score', 'hearts', 'ok', 'bad', 'n', 'tt', 'done', 'ts', 'rid', 'm', 'r', 'pr', 'pid', 'jt', 'rk', 'pv', 'tk', 'br']);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------- Arkadaşlar ----------
    // pk/{id}: oyuncu kimliğinin sahipliği (gizli anahtar k). Okunamaz; aynı anahtarla yeni telefona taşınabilir.
    function owns(pid) { return signedIn() && get(/databases/$(database)/documents/pk/$(pid)).data.u == request.auth.uid; }
    function frId(x, y) { return x < y ? x + '_' + y : y + '_' + x; }
    match /pk/{pid} {
      allow create: if signedIn() && pid.size() == 7
        && request.resource.data.keys().hasOnly(['k', 'u'])
        && request.resource.data.u == request.auth.uid
        && request.resource.data.k is string && request.resource.data.k.size() >= 16;
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['k', 'u'])
        && request.resource.data.k == resource.data.k
        && request.resource.data.u == request.auth.uid;
      allow delete: if signedIn() && resource.data.u == request.auth.uid;
    }
    // pl/{id}: herkese açık oyuncu kartı (takma ad + en son görülme + rütbe rk + madalyalar md (S48) + istatistik st (S49))
    match /pl/{pid} {
      allow read: if signedIn();
      allow create, update: if owns(pid)
        && request.resource.data.keys().hasOnly(['nick', 'seen', 'v', 'rk', 'md', 'st', 'tm'])
        && (!('tm' in request.resource.data) || (request.resource.data.tm is string && request.resource.data.tm.size() <= 4))
        && (!('st' in request.resource.data) || (request.resource.data.st is string && request.resource.data.st.size() <= 60))
        && (!('rk' in request.resource.data) || (request.resource.data.rk is int && request.resource.data.rk >= 0 && request.resource.data.rk <= 6))
        && (!('md' in request.resource.data) || (request.resource.data.md is string && request.resource.data.md.size() <= 12))
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 1 && request.resource.data.nick.size() <= 60
        && request.resource.data.seen is int;
      allow delete: if owns(pid);
    }
    // fr/{a_b}: arkadaşlık (istek 'req' → kabul 'ok'); sadece taraflar değiştirebilir
    match /fr/{id} {
      allow read: if signedIn();
      allow create: if request.resource.data.keys().hasOnly(['a', 'b', 'by', 'st', 'ts'])
        && request.resource.data.a < request.resource.data.b
        && id == frId(request.resource.data.a, request.resource.data.b)
        && request.resource.data.by in [request.resource.data.a, request.resource.data.b]
        && request.resource.data.st == 'req'
        && owns(request.resource.data.by);
      allow update: if resource.data.st == 'req' && request.resource.data.st == 'ok'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'ts'])
        && owns(resource.data.by == resource.data.a ? resource.data.b : resource.data.a);
      allow delete: if owns(resource.data.a) || owns(resource.data.b);
    }
    // iv/{alıcı}: kapışma daveti; sadece arkadaşlar gönderebilir, sadece alıcı ve gönderen görür
    match /iv/{to} {
      allow get: if owns(to) || (resource != null && owns(resource.data.from));
      // S55: toplu davet (g) başkasının açık davetinin üzerine yazamaz
      allow create, update: if request.resource.data.keys().hasOnly(['from', 'nick', 'room', 'op', 'lv', 'win', 'ts', 'md', 'g'])
        && owns(request.resource.data.from)
        && (!('g' in request.resource.data) || resource == null
          || resource.data.from == request.resource.data.from
          || request.time.toMillis() - resource.data.ts > 600000
          || ('rs' in resource.data && resource.data.rs != 'seen'))
        && get(/databases/$(database)/documents/fr/$(frId(request.resource.data.from, to))).data.st == 'ok';
      // S54: alıcı sadece cevabını yazar (gördü / kabul / meşgul / daha sonra + randevu odası ve saati)
      allow update: if owns(to)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rs', 'rr', 'ra'])
        && request.resource.data.rs in ['seen', 'ok', 'busy', 'later']
        && (!('rr' in request.resource.data) || (request.resource.data.rr is string && request.resource.data.rr.size() <= 10))
        && (!('ra' in request.resource.data) || request.resource.data.ra is int);
      allow delete: if owns(to) || owns(resource.data.from);
    }

    // S56: tm/{ad no}: takım. m = üye oyuncu kimlikleri (en çok 4), cap = kaptan, by = yazan üye.
    function tmM(k) { return get(/databases/$(database)/documents/tm/$(k)).data.m; }
    match /tm/{k} {
      allow read: if signedIn();
      allow create: if k.matches('^[0-9]{1,3}$')
        && request.resource.data.keys().hasOnly(['m', 'cap', 'by', 'w', 'l', 'ct', 'jn', 'lm', 'ts', 'v'])
        && owns(request.resource.data.by)
        && request.resource.data.m == [request.resource.data.by]
        && request.resource.data.cap == request.resource.data.by
        && request.resource.data.w == 0 && request.resource.data.l == 0;
      // katılma: sadece kendini ekler, geçerli takım daveti (tv) olmalı
      allow update: if request.resource.data.keys().hasOnly(['m', 'cap', 'by', 'w', 'l', 'ct', 'jn', 'lm', 'ts', 'v'])
        && owns(request.resource.data.by)
        && request.resource.data.m.size() == resource.data.m.size() + 1
        && request.resource.data.m.size() <= 4
        && request.resource.data.m.hasAll(resource.data.m)
        && request.resource.data.by in request.resource.data.m
        && !(request.resource.data.by in resource.data.m)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['m', 'by', 'jn', 'ts'])
        && get(/databases/$(database)/documents/tv/$(request.resource.data.by)).data.t == int(k);
      // ayrılma: sadece kendini çıkarır; kimse başkasını çıkaramaz
      allow update: if request.resource.data.keys().hasOnly(['m', 'cap', 'by', 'w', 'l', 'ct', 'jn', 'lm', 'ts', 'v'])
        && owns(request.resource.data.by)
        && request.resource.data.by in resource.data.m
        && request.resource.data.m.size() == resource.data.m.size() - 1
        && resource.data.m.hasAll(request.resource.data.m)
        && !(request.resource.data.by in request.resource.data.m)
        && request.resource.data.cap in request.resource.data.m
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['m', 'by', 'cap', 'ts']);
      // kaptan, galibiyet/yenilgi (en çok 1 artar)
      allow update: if request.resource.data.keys().hasOnly(['m', 'cap', 'by', 'w', 'l', 'ct', 'jn', 'lm', 'ts', 'v'])
        && owns(request.resource.data.by)
        && request.resource.data.by in resource.data.m
        && request.resource.data.m == resource.data.m
        && request.resource.data.cap in resource.data.m
        && request.resource.data.w - resource.data.w in [0, 1]
        && request.resource.data.l - resource.data.l in [0, 1]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cap', 'ct', 'w', 'l', 'lm', 'by', 'ts']);
      allow delete: if resource.data.m.size() == 1 && owns(resource.data.m[0]);
    }
    // tv/{alıcı}: takıma çağırma (üye → arkadaşı)
    match /tv/{to} {
      allow get: if owns(to) || (resource != null && owns(resource.data.from));
      allow create, update: if request.resource.data.keys().hasOnly(['t', 'from', 'nick', 'ts'])
        && request.resource.data.t is int && request.resource.data.ts is int
        && owns(request.resource.data.from)
        && request.resource.data.from in tmM(string(request.resource.data.t))
        && get(/databases/$(database)/documents/fr/$(frId(request.resource.data.from, to))).data.st == 'ok';
      allow delete: if owns(to) || owns(resource.data.from);
    }
    // ti/{takım}: takım çağrısı (kapışma ya da kaptanlık maçı); takımın üyeleri dinler
    match /ti/{k} {
      allow read: if signedIn();
      allow create, update: if request.resource.data.keys().hasOnly(['by', 'nick', 'room', 'a', 'b', 'ts', 'cm'])
        && request.resource.data.a is int && request.resource.data.b is int
        && owns(request.resource.data.by)
        && request.resource.data.by in tmM(string(request.resource.data.a))
        && (int(k) == request.resource.data.a || int(k) == request.resource.data.b);
      allow delete: if owns(resource.data.by);
    }

    // S55: ms/{gönderen}_{alıcı}: hazır mesaj (sadece numara m; serbest yazı yok), sadece arkadaşa
    match /ms/{id} {
      allow read: if signedIn();
      allow create, update: if request.resource.data.keys().hasOnly(['from', 'to', 'm', 'ts', 'nick'])
        && id == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.m is int && request.resource.data.m >= 1 && request.resource.data.m <= 60
        && request.resource.data.ts is int
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 60
        && owns(request.resource.data.from)
        && get(/databases/$(database)/documents/fr/$(frId(request.resource.data.from, request.resource.data.to))).data.st == 'ok';
      allow delete: if owns(resource.data.from) || owns(resource.data.to);
    }

    // S54: rv/{ODA}_{alıcı}: zamanlı oyun (randevu) isteği. Kurucu (from) odayı önceden kurar; alıcı Olur/Gelemem der.
    match /rv/{id} {
      allow read: if signedIn();
      allow create: if request.resource.data.keys().hasOnly(['from', 'fn', 'to', 'room', 'op', 'lv', 'win', 'md', 'at', 'ts', 'st', 'n'])
        && owns(request.resource.data.from)
        && id == request.resource.data.room + '_' + request.resource.data.to
        && request.resource.data.st == 'req'
        && request.resource.data.at is int && request.resource.data.ts is int
        && request.resource.data.md in ['duel', 'mm']
        && request.resource.data.fn is string && request.resource.data.fn.size() <= 60
        && get(/databases/$(database)/documents/fr/$(frId(request.resource.data.from, request.resource.data.to))).data.st == 'ok'
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.room)).data.host == request.auth.uid;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'ts'])
        && ((owns(resource.data.to) && request.resource.data.st in ['ok', 'no'])
          || (owns(resource.data.from) && request.resource.data.st in ['x', 'd']));
      allow delete: if owns(resource.data.to) || owns(resource.data.from);
    }

    // ps/{id}: bildirim adresi (S49). Okumak için oturum yeter (adres tek başına bildirim göndermeye yetmez, sunucunun VAPID anahtarı gerekir)
    match /ps/{pid} {
      allow get: if signedIn();
      allow create, update: if owns(pid)
        && request.resource.data.keys().hasOnly(['e', 'k', 'a', 'ts'])
        && request.resource.data.e is string && request.resource.data.e.size() < 800 && request.resource.data.e.matches('^https://.*')
        && request.resource.data.k is string && request.resource.data.k.size() < 200
        && request.resource.data.a is string && request.resource.data.a.size() < 100
        && request.resource.data.ts is int;
      allow delete: if owns(pid);
    }

    // Otomatik yedek: belge id = 10 karakterlik gizli yedek kodu; sadece tek belge okunur (liste yok)
    match /bk/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.size() == 10
        && request.resource.data.u == request.auth.uid
        && request.resource.data.keys().hasOnly(['u', 'd', 'ts', 'v'])
        && request.resource.data.d is string && request.resource.data.d.size() < 900000;
      allow update: if signedIn() && resource.data.u == request.auth.uid
        && request.resource.data.u == request.auth.uid
        && request.resource.data.keys().hasOnly(['u', 'd', 'ts', 'v'])
        && request.resource.data.d is string && request.resource.data.d.size() < 900000;
      // S53: "Verilerimi sil"
      allow delete: if signedIn() && resource.data.u == request.auth.uid;
    }

    // S53: hesap özeti (eşitleme): belge id = hesap kodu (bk ile aynı). Küçük belge; açılışta sadece bu okunur.
    // ts: son yazılan yedeğin zamanı, dv: yazan cihaz, ln/lnd: hesabın en son açıldığı zaman ve cihaz, del: hesap silindi
    match /ac/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.size() == 10
        && request.resource.data.u == request.auth.uid
        && request.resource.data.keys().hasOnly(['u', 'ts', 'dv', 'ln', 'lnd', 'del', 'v'])
        && request.resource.data.ts is int;
      allow update: if signedIn() && resource.data.u == request.auth.uid
        && request.resource.data.u == request.auth.uid
        && request.resource.data.keys().hasOnly(['u', 'ts', 'dv', 'ln', 'lnd', 'del', 'v'])
        && request.resource.data.ts is int;
    }

    // Oyun adı kaydı (S46): belge id = karakter_numara; aynı adı iki kişi alamaz (var olan belgeye sadece sahibi yazabilir)
    match /nm/{k} {
      allow get: if signedIn();
      allow create: if signedIn() && k.matches('^[0-9]{1,3}_[0-9]{1,4}$')
        && request.resource.data.keys().hasOnly(['u', 't'])
        && request.resource.data.u == request.auth.uid && request.resource.data.t is int;
      allow update: if signedIn() && resource.data.u == request.auth.uid
        && request.resource.data.keys().hasOnly(['u', 't'])
        && request.resource.data.u == request.auth.uid && request.resource.data.t is int;
      allow delete: if signedIn() && resource.data.u == request.auth.uid;
    }

    // Rekorlar tablosu: her hesap (S53'ten beri hesap = karakter), her kategori için tek belge; sadece kendi belgesi, puan sadece artabilir
    match /{coll}/{uid} {
      allow read: if signedIn() && lbOk(coll);
      allow create: if signedIn() && request.auth.uid == uid
        && lbOk(coll)
        && request.resource.data.keys().hasOnly(['nick', 'score', 'ts', 'pid', 'rk'])
        && (!('pid' in request.resource.data) || (request.resource.data.pid is string && request.resource.data.pid.size() <= 10))
        && (!('rk' in request.resource.data) || (request.resource.data.rk is int && request.resource.data.rk >= 0 && request.resource.data.rk <= 6))
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 1 && request.resource.data.nick.size() <= 60
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 5000;
      allow update: if signedIn() && request.auth.uid == uid
        && lbOk(coll)
        && request.resource.data.keys().hasOnly(['nick', 'score', 'ts', 'pid', 'rk'])
        && (!('pid' in request.resource.data) || (request.resource.data.pid is string && request.resource.data.pid.size() <= 10))
        && (!('rk' in request.resource.data) || (request.resource.data.rk is int && request.resource.data.rk >= 0 && request.resource.data.rk <= 6))
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 1 && request.resource.data.nick.size() <= 60
        && request.resource.data.score is int && request.resource.data.score >= resource.data.score && request.resource.data.score <= 5000;
      // S53: kendi satırını silebilir (tek karaktere geçişte eski satır temizliği, "Verilerimi sil")
      allow delete: if signedIn() && request.auth.uid == uid && lbOk(coll);
    }
  }
}
