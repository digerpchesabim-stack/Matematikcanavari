rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function lbOk(c) { return c in ['lbg_add','lbg_add_o','lbg_add_z','lbg_sub','lbg_sub_o','lbg_sub_z','lbg_mul','lbg_mul_o','lbg_mul_z','lbg_div','lbg_div_o','lbg_div_z','lbg_rnd','lbg_rnd_o','lbg_rnd_z','lbr_add','lbr_add_o','lbr_add_z','lbr_sub','lbr_sub_o','lbr_sub_z','lbr_mul','lbr_mul_o','lbr_mul_z','lbr_div','lbr_div_o','lbr_div_z','lbr_rnd','lbr_rnd_o','lbr_rnd_z']; }

    // Yarış odaları
    match /rooms/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.host == request.auth.uid
        && request.resource.data.keys().hasOnly(['host', 'hostNick', 'op', 'status', 'seed', 'created', 'qv', 'lv', 'tb', 'mode', 'win'])
        && (!('mode' in request.resource.data) || request.resource.data.mode in ['duel', 'mm'])
        && (!('win' in request.resource.data) || request.resource.data.win in [10, 15, 20])
        && (!('lv' in request.resource.data) || request.resource.data.lv in ['k', 'o', 'z'])
        && (!('tb' in request.resource.data) || (request.resource.data.tb is int && request.resource.data.tb >= 0 && request.resource.data.tb <= 10))
        && request.resource.data.status == 'lobby'
        && request.resource.data.op in ['add', 'sub', 'mul', 'div', 'rnd']
        && code.size() >= 3 && code.size() <= 10;
      // Sadece kurucu, sadece durumu "playing" yapabilir
      allow update: if signedIn()
        && resource.data.host == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'playing';
      allow delete: if signedIn() && (resource.data.host == request.auth.uid
        || request.time.toMillis() - resource.data.created > 86400000);

      match /players/{uid} {
        allow read: if signedIn();
        // Yeni oyuncu sadece oda "lobby" iken girebilir
        allow create: if signedIn() && request.auth.uid == uid
          && get(/databases/$(database)/documents/rooms/$(code)).data.status == 'lobby'
          && request.resource.data.keys().hasOnly(['nick', 'score', 'hearts', 'ok', 'bad', 'n', 'tt', 'done', 'ts', 'rid', 'm', 'r', 'pr', 'pid', 'jt', 'rk', 'pv'])
          && request.resource.data.nick is string && request.resource.data.nick.size() <= 60;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['nick', 'score', 'hearts', 'ok', 'bad', 'n', 'tt', 'done', 'ts', 'rid', 'm', 'r', 'pr', 'pid', 'jt', 'rk', 'pv']);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------- Arkadaşlar ----------
    // pk/{id}: oyuncu kimliğinin sahipliği (gizli anahtar k). Okunamaz; aynı anahtarla yeni telefona taşınabilir.
    function owns(pid) { return signedIn() && get(/databases/$(database)/documents/pk/$(pid)).data.u == request.auth.uid; }
    function frId(x, y) { return x < y ? x + '_' + y : y + '_' + x; }
    match /pk/{pid} {
      allow create: if signedIn() && pid.size() == 7
        && request.resource.data.keys().hasOnly(['k', 'u'])
        && request.resource.data.u == request.auth.uid
        && request.resource.data.k is string && request.resource.data.k.size() >= 16;
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['k', 'u'])
        && request.resource.data.k == resource.data.k
        && request.resource.data.u == request.auth.uid;
      allow delete: if signedIn() && resource.data.u == request.auth.uid;
    }
    // pl/{id}: herkese açık oyuncu kartı (takma ad + en son görülme + rütbe rk + madalyalar md (S48) + istatistik st (S49))
    match /pl/{pid} {
      allow read: if signedIn();
      allow create, update: if owns(pid)
        && request.resource.data.keys().hasOnly(['nick', 'seen', 'v', 'rk', 'md', 'st'])
        && (!('st' in request.resource.data) || (request.resource.data.st is string && request.resource.data.st.size() <= 60))
        && (!('rk' in request.resource.data) || (request.resource.data.rk is int && request.resource.data.rk >= 0 && request.resource.data.rk <= 6))
        && (!('md' in request.resource.data) || (request.resource.data.md is string && request.resource.data.md.size() <= 12))
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 1 && request.resource.data.nick.size() <= 60
        && request.resource.data.seen is int;
      allow delete: if owns(pid);
    }
    // fr/{a_b}: arkadaşlık (istek 'req' → kabul 'ok'); sadece taraflar değiştirebilir
    match /fr/{id} {
      allow read: if signedIn();
      allow create: if request.resource.data.keys().hasOnly(['a', 'b', 'by', 'st', 'ts'])
        && request.resource.data.a < request.resource.data.b
        && id == frId(request.resource.data.a, request.resource.data.b)
        && request.resource.data.by in [request.resource.data.a, request.resource.data.b]
        && request.resource.data.st == 'req'
        && owns(request.resource.data.by);
      allow update: if resource.data.st == 'req' && request.resource.data.st == 'ok'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'ts'])
        && owns(resource.data.by == resource.data.a ? resource.data.b : resource.data.a);
      allow delete: if owns(resource.data.a) || owns(resource.data.b);
    }
    // iv/{alıcı}: kapışma daveti; sadece arkadaşlar gönderebilir, sadece alıcı ve gönderen görür
    match /iv/{to} {
      allow get: if owns(to) || (resource != null && owns(resource.data.from));
      allow create, update: if request.resource.data.keys().hasOnly(['from', 'nick', 'room', 'op', 'lv', 'win', 'ts', 'md'])
        && owns(request.resource.data.from)
        && get(/databases/$(database)/documents/fr/$(frId(request.resource.data.from, to))).data.st == 'ok';
      allow delete: if owns(to) || owns(resource.data.from);
    }

    // ps/{id}: bildirim adresi (S49). Okumak için oturum yeter (adres tek başına bildirim göndermeye yetmez, sunucunun VAPID anahtarı gerekir)
    match /ps/{pid} {
      allow get: if signedIn();
      allow create, update: if owns(pid)
        && request.resource.data.keys().hasOnly(['e', 'k', 'a', 'ts'])
        && request.resource.data.e is string && request.resource.data.e.size() < 800 && request.resource.data.e.matches('^https://.*')
        && request.resource.data.k is string && request.resource.data.k.size() < 200
        && request.resource.data.a is string && request.resource.data.a.size() < 100
        && request.resource.data.ts is int;
      allow delete: if owns(pid);
    }

    // Otomatik yedek: belge id = 10 karakterlik gizli yedek kodu; sadece tek belge okunur (liste yok)
    match /bk/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.size() == 10
        && request.resource.data.u == request.auth.uid
        && request.resource.data.keys().hasOnly(['u', 'd', 'ts', 'v'])
        && request.resource.data.d is string && request.resource.data.d.size() < 900000;
      allow update: if signedIn() && resource.data.u == request.auth.uid
        && request.resource.data.u == request.auth.uid
        && request.resource.data.keys().hasOnly(['u', 'd', 'ts', 'v'])
        && request.resource.data.d is string && request.resource.data.d.size() < 900000;
    }

    // Oyun adı kaydı (S46): belge id = karakter_numara; aynı adı iki kişi alamaz (var olan belgeye sadece sahibi yazabilir)
    match /nm/{k} {
      allow get: if signedIn();
      allow create: if signedIn() && k.matches('^[0-9]{1,3}_[0-9]{1,4}$')
        && request.resource.data.keys().hasOnly(['u', 't'])
        && request.resource.data.u == request.auth.uid && request.resource.data.t is int;
      allow update: if signedIn() && resource.data.u == request.auth.uid
        && request.resource.data.keys().hasOnly(['u', 't'])
        && request.resource.data.u == request.auth.uid && request.resource.data.t is int;
      allow delete: if signedIn() && resource.data.u == request.auth.uid;
    }

    // Rekorlar tablosu: her cihaz, her kategori için tek belge; sadece kendi belgesi, puan sadece artabilir
    match /{coll}/{uid} {
      allow read: if signedIn() && lbOk(coll);
      allow create: if signedIn() && request.auth.uid == uid
        && lbOk(coll)
        && request.resource.data.keys().hasOnly(['nick', 'score', 'ts', 'pid', 'rk'])
        && (!('pid' in request.resource.data) || (request.resource.data.pid is string && request.resource.data.pid.size() <= 10))
        && (!('rk' in request.resource.data) || (request.resource.data.rk is int && request.resource.data.rk >= 0 && request.resource.data.rk <= 6))
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 1 && request.resource.data.nick.size() <= 60
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 5000;
      allow update: if signedIn() && request.auth.uid == uid
        && lbOk(coll)
        && request.resource.data.keys().hasOnly(['nick', 'score', 'ts', 'pid', 'rk'])
        && (!('pid' in request.resource.data) || (request.resource.data.pid is string && request.resource.data.pid.size() <= 10))
        && (!('rk' in request.resource.data) || (request.resource.data.rk is int && request.resource.data.rk >= 0 && request.resource.data.rk <= 6))
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 1 && request.resource.data.nick.size() <= 60
        && request.resource.data.score is int && request.resource.data.score >= resource.data.score && request.resource.data.score <= 5000;
      // Silme yok: uygunsuz adı Firebase konsolundan elle sil.
    }
  }
}
